# Copy to .env:  cp .env.example .env
# All values below are safe local defaults — no secrets, no paid services.

# --- Database (PostgreSQL) ---
DB_DATABASE=mercuriodb
DB_TEST_DATABASE=mercuriodb_test
DB_USERNAME=mercurio
DB_PASSWORD=mercurio

# --- URLs ---
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# --- Catalogue ---
# fakestore | fixture  (fixture = bundled snapshot, works offline)
CATALOGUE_SOURCE=fakestore
FAKESTORE_BASE_URL=https://fakestoreapi.com
MAX_TOP_RATED=5

# --- Enquiry notifications ---
# null = store only, visible on admin Queries page | mail = also email SALES_INBOX
ENQUIRY_NOTIFIER=null
SALES_INBOX=sales@mercurio.test
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@mercurio.test

# --- Seeded admin (local demo credentials only) ---
ADMIN_EMAIL=admin@mercurio.test
ADMIN_PASSWORD=password
